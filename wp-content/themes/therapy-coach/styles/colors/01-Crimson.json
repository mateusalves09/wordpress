{
  "$schema": "https://schemas.wp.org/wp/6.9/theme.json",
  "version": 3,
  "title": "Crimson",
  "settings": {
    "color": {
      "palette": [
        { "slug": "primary",          "color": "#C03040", "name": "Primary" },
        { "slug": "primary-dark",     "color": "#7A1A28", "name": "Primary Dark" },
        { "slug": "primary-light",    "color": "#DDA0A8", "name": "Primary Light" },
        { "slug": "primary-soft",     "color": "#F5E0E4", "name": "Primary Soft" },
        { "slug": "heading-text",     "color": "#1A0A0C", "name": "Text Dark" },
        { "slug": "paragraph-text",   "color": "#5A4548", "name": "Text Light" },
        { "slug": "muted-text",       "color": "#7A6568", "name": "Muted Text" },
        { "slug": "white",            "color": "#FFFFFF", "name": "White" },
        { "slug": "background-light", "color": "#FDF5F6", "name": "Background Light" },
        { "slug": "background-dark",  "color": "#FAECEE", "name": "Background Dark" },
        { "slug": "rule",             "color": "#EDD8DC", "name": "Border" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background-light)",
      "text": "var(--wp--preset--color--heading-text)"
    },
    "elements": {
      "h1": { "color": { "text": "var(--wp--preset--color--heading-text)" } },
      "h2": { "color": { "text": "var(--wp--preset--color--heading-text)" } },
      "h3": { "color": { "text": "var(--wp--preset--color--heading-text)" } },
      "link": { "color": { "text": "var(--wp--preset--color--primary)" } },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--white)"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--primary-dark)",
            "text": "var(--wp--preset--color--white)"
          }
        }
      }
    },
    "blocks": {
      "core/button": {
        "color": {
          "background": "var:preset|color|primary",
          "text": "var:preset|color|white"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|primary-dark",
            "text": "var:preset|color|white"
          }
        }
      }
    },
    "border": {
      "color": "var:preset|color|border"
    }
  }
}
