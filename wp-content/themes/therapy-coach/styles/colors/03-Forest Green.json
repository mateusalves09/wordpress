{
  "$schema": "https://schemas.wp.org/wp/6.9/theme.json",
  "version": 3,
  "title": "Forest Green",
  "settings": {
    "color": {
      "palette": [
        { "slug": "primary",          "color": "#5A7854", "name": "Primary" },
        { "slug": "primary-dark",     "color": "#283826", "name": "Primary Dark" },
        { "slug": "primary-light",    "color": "#92B08E", "name": "Primary Light" },
        { "slug": "primary-soft",     "color": "#E0EADE", "name": "Primary Soft" },
        { "slug": "heading-text",     "color": "#0C150A", "name": "Text Dark" },
        { "slug": "paragraph-text",   "color": "#455040", "name": "Text Light" },
        { "slug": "muted-text",       "color": "#636E60", "name": "Muted Text" },
        { "slug": "white",            "color": "#FFFFFF", "name": "White" },
        { "slug": "background-light", "color": "#F4F8F3", "name": "Background Light" },
        { "slug": "background-dark",  "color": "#E8F0E5", "name": "Background Dark" },
        { "slug": "rule",             "color": "#CCE0C8", "name": "Border" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background-light)",
      "text": "var(--wp--preset--color--heading-text)"
    },
    "elements": {
      "h1": { "color": { "text": "var(--wp--preset--color--heading-text)" } },
      "h2": { "color": { "text": "var(--wp--preset--color--heading-text)" } },
      "h3": { "color": { "text": "var(--wp--preset--color--heading-text)" } },
      "link": { "color": { "text": "var(--wp--preset--color--primary)" } },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--white)"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--primary-dark)",
            "text": "var(--wp--preset--color--white)"
          }
        }
      }
    },
    "blocks": {
      "core/button": {
        "color": {
          "background": "var:preset|color|primary",
          "text": "var:preset|color|white"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|primary-dark",
            "text": "var:preset|color|white"
          }
        }
      }
    },
    "border": {
      "color": "var:preset|color|border"
    }
  }
}
