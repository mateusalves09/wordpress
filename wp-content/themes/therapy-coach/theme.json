{
  "$schema": "https://schemas.wp.org/wp/6.9/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "slug": "primary",
          "color": "#17614B",
          "name": "Primary"
        },
        {
          "slug": "primary-dark",
          "color": "#104936",
          "name": "Primary Dark"
        },
        {
          "slug": "primary-light",
          "color": "#407B65",
          "name": "Primary Light"
        },
        {
          "slug": "primary-soft",
          "color": "#E2EBDF",
          "name": "Primary Soft"
        },
        {
          "slug": "heading-text",
          "color": "#142A36",
          "name": "Text Dark"
        },
        {
          "slug": "paragraph-text",
          "color": "#4B5C61",
          "name": "Text Light"
        },
        {
          "slug": "muted-text",
          "color": "#4B5C61",
          "name": "Muted Text"
        },
        {
          "slug": "white",
          "color": "#FFFFFF",
          "name": "White"
        },
        {
          "slug": "background-light",
          "color": "#F8F9F4",
          "name": "Background Light"
        },
        {
          "slug": "background-dark",
          "color": "#EEF2E9",
          "name": "Background Dark"
        },
        {
          "slug": "mist",
          "color": "#E7EEED",
          "name": "Mist"
        },
        {
          "slug": "rule",
          "color": "#D7DFD8",
          "name": "Border"
        },
        {
          "slug": "gradient-start",
          "color": "#E2EBDF",
          "name": "Gradient Start"
        },
        {
          "slug": "gradient-end",
          "color": "#F8F9F4",
          "name": "Gradient End"
        }
      ]
    },
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "name": "Tiny",
          "size": "10px",
          "slug": "20"
        },
        {
          "name": "X-Small",
          "size": "20px",
          "slug": "30"
        },
        {
          "name": "Small",
          "size": "30px",
          "slug": "40"
        },
        {
          "name": "Regular",
          "size": "clamp(30px, 5vw, 50px)",
          "slug": "50"
        },
        {
          "name": "Large",
          "size": "clamp(30px, 7vw, 70px)",
          "slug": "60"
        },
        {
          "name": "X-Large",
          "size": "clamp(50px, 7vw, 90px)",
          "slug": "70"
        },
        {
          "name": "XX-Large",
          "size": "clamp(70px, 10vw, 140px)",
          "slug": "80"
        }
      ],
      "units": [
        "%",
        "px",
        "em",
        "rem",
        "vh",
        "vw",
        "svh"
      ]
    },
    "typography": {
      "writingMode": true,
      "defaultFontSizes": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "inter",
          "name": "Work Sans",
          "fontFamily": "\"Work Sans\", system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Work Sans",
              "fontWeight": "400",
              "fontStyle": "normal",
              "src": [
                "file:./assets/fonts/work-sans/WorkSans-Regular.ttf"
              ]
            },
            {
              "fontFamily": "Work Sans",
              "fontWeight": "500",
              "fontStyle": "normal",
              "src": [
                "file:./assets/fonts/work-sans/WorkSans-Medium.ttf"
              ]
            }
          ]
        },
        {
          "slug": "fraunces",
          "name": "Playfair Display",
          "fontFamily": "\"Playfair Display\", Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Playfair Display",
              "fontWeight": "400",
              "fontStyle": "normal",
              "src": [
                "file:./assets/fonts/Playfair_Display/PlayfairDisplay-Regular.ttf"
              ]
            },
            {
              "fontFamily": "Playfair Display",
              "fontWeight": "500",
              "fontStyle": "normal",
              "src": [
                "file:./assets/fonts/Playfair_Display/PlayfairDisplay-Medium.ttf"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "display-xl",
          "name": "Display XL",
          "size": "60px"
        },
        {
          "slug": "display-lg",
          "name": "Display LG",
          "size": "44px"
        },
        {
          "slug": "heading-md",
          "name": "Heading MD",
          "size": "24px"
        },
        {
          "slug": "heading-sm",
          "name": "Heading SM",
          "size": "18px"
        },
        {
          "slug": "body-lg",
          "name": "Body LG",
          "size": "18px"
        },
        {
          "slug": "body-md",
          "name": "Body MD",
          "size": "16px"
        },
        {
          "slug": "body-sm",
          "name": "Body SM",
          "size": "14px"
        },
        {
          "slug": "caption",
          "name": "Caption",
          "size": "12px"
        },
        {
          "slug": "button",
          "name": "Button",
          "size": "14px"
        }
      ]
    },
    "custom": {
      "typography": {
        "font-weight": {
          "light": "300",
          "regular": "400",
          "medium": "500",
          "semibold": "600",
          "bold": "700"
        },
        "line-height": {
          "display-xl": "1.1",
          "display-lg": "1.15",
          "heading-md": "1.25",
          "heading-sm": "1.3",
          "body-lg": "1.55",
          "body-md": "1.5",
          "body-sm": "1.5",
          "caption": "1.4",
          "button": "1",
          "flat": "1"
        },
        "letter-spacing": {
          "heading": "-0.03em",
          "heading-sm": "-0.02em",
          "label": "0.2em",
          "eyebrow": "0.12em"
        }
      },
      "spacing": {
        "gap": {
          "horizontal": "30px",
          "vertical": "30px"
        }
      }
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background-light)",
      "text": "var(--wp--preset--color--heading-text)"
    },
    "spacing": {
      "blockGap": "0",
      "padding": {
        "left": "var:preset|spacing|50",
        "right": "var:preset|spacing|50"
      }
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "16px",
      "lineHeight": "1.6"
    },
    "blocks": {
      "core/avatar": {
        "border": {
          "radius": "100px"
        }
      },
      "core/button": {
        "color": {
          "background": "var:preset|color|primary",
          "text": "var:preset|color|white"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|inter",
          "fontSize": "var:preset|font-size|button",
          "fontWeight": "500",
          "lineHeight": "var:custom|typography|line-height|button",
          "textTransform": "capitalize"
        },
        "spacing": {
          "padding": {
            "top": "16px",
            "bottom": "16px",
            "left": "36px",
            "right": "36px"
          }
        },
        "border": {
          "radius": "50px"
        },
        ":hover": {
          "color": {
            "background": "color-mix(in srgb, var(--wp--preset--color--accent) 85%, transparent)",
            "text": "var:preset|color|base"
          }
        },
        ":focus": {
          "outline": {
            "color": "var:preset|color|muted",
            "offset": "2px"
          }
        },
        "variations": {
          "outline": {
            "border": {
              "color": "currentColor",
              "width": "1px"
            },
            "css": ".wp-block-button__link:not(.has-background):hover {background-color:color-mix(in srgb, var(--wp--preset--color--accent) 5%, transparent);}",
            "spacing": {
              "padding": {
                "bottom": "calc(16px - 1px)",
                "left": "calc(36px - 1px)",
                "right": "calc(36px - 1px)",
                "top": "calc(16px - 1px)"
              }
            }
          }
        },
        "css": "text-wrap: pretty;"
      },
      "core/buttons": {
        "spacing": {
          "blockGap": "16px"
        }
      },
      "core/columns": {
        "spacing": {
          "blockGap": "var:preset|spacing|50",
          "margin": {
            "top": "0",
            "bottom": "0",
            "left": "0",
            "right": "0"
          }
        }
      },
      "core/code": {
        "typography": {
          "fontFamily": "var:preset|font-family|inter",
          "fontSize": "var:preset|font-size|regular",
          "fontWeight": "400"
        },
        "color": {
          "background": "var:preset|color|surface",
          "text": "var:preset|color|ink-2"
        },
        "spacing": {
          "padding": {
            "right": "var:preset|spacing|40",
            "bottom": "var:preset|spacing|40",
            "left": "var:preset|spacing|40",
            "top": "var:preset|spacing|40"
          }
        }
      },
      "core/comment-author-name": {
        "color": {
          "text": "var:preset|color|muted"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|muted"
            },
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "typography": {
                "textDecoration": "underline"
              }
            }
          }
        },
        "typography": {
          "fontSize": "var:preset|font-size|small"
        },
        "spacing": {
          "margin": {
            "top": "5px",
            "bottom": "0px"
          }
        }
      },
      "core/comment-content": {
        "typography": {
          "fontSize": "var:preset|font-size|regular"
        },
        "spacing": {
          "margin": {
            "top": "var:preset|spacing|30",
            "bottom": "var:preset|spacing|30"
          }
        }
      },
      "core/comment-date": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        },
        "color": {
          "text": "var:preset|color|ink-2"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|ink-2"
            }
          }
        }
      },
      "core/comment-edit-link": {
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|ink-2"
            }
          }
        },
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "core/comment-reply-link": {
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|ink-2"
            }
          }
        },
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "core/post-comments-form": {
        "css": "& textarea, input:not([type=submit]){border-radius:.25rem; border-color: var(--wp--preset--color--rule) !important;} & input[type=checkbox]{margin:0 .2rem 0 0 !important;} & label {font-size: var(--wp--preset--font-size--small); }",
        "typography": {
          "fontSize": "var:preset|font-size|regular"
        },
        "spacing": {
          "padding": {
            "top": "var:preset|spacing|40",
            "bottom": "var:preset|spacing|40"
          }
        }
      },
      "core/comments-pagination": {
        "typography": {
          "fontSize": "var:preset|font-size|regular"
        },
        "spacing": {
          "margin": {
            "top": "var:preset|spacing|40",
            "bottom": "var:preset|spacing|40"
          }
        }
      },
      "core/comments-pagination-next": {
        "typography": {
          "fontSize": "var:preset|font-size|regular"
        }
      },
      "core/comments-pagination-numbers": {
        "typography": {
          "fontSize": "var:preset|font-size|regular"
        }
      },
      "core/comments-pagination-previous": {
        "typography": {
          "fontSize": "var:preset|font-size|regular"
        }
      },
      "core/post-date": {
        "color": {
          "text": "var:preset|color|muted"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|muted"
            },
            ":hover": {
              "typography": {
                "textDecoration": "underline"
              }
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        },
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "core/post-navigation-link": {
        "typography": {
          "fontSize": "var:preset|font-size|regular"
        }
      },
      "core/post-terms": {
        "css": "& a { white-space: nowrap; }",
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "500"
        }
      },
      "core/post-title": {
        "elements": {
          "link": {
            ":hover": {
              "typography": {
                "textDecoration": "underline"
              }
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/quote": {
        "border": {
          "style": "solid",
          "width": "0 0 0 2px",
          "color": "currentColor"
        },
        "spacing": {
          "blockGap": "var:preset|spacing|30",
          "margin": {
            "left": "0",
            "right": "0"
          },
          "padding": {
            "top": "var:preset|spacing|30",
            "right": "var:preset|spacing|40",
            "bottom": "var:preset|spacing|30",
            "left": "var:preset|spacing|40"
          }
        },
        "typography": {
          "fontSize": "var:preset|font-size|large",
          "fontWeight": "400"
        },
        "elements": {
          "cite": {
            "typography": {
              "fontSize": "var:preset|font-size|small",
              "fontStyle": "normal",
              "fontWeight": "400"
            },
            "css": "& sub { font-size: 0.65em }"
          }
        },
        "css": "&.has-text-align-right { border-width: 0 2px 0 0; } &.has-text-align-center { border-width: 0;border-inline: 0; padding-inline: 0; }",
        "variations": {
          "plain": {
            "border": {
              "color": "transparent",
              "style": "none",
              "width": "0",
              "radius": "0"
            },
            "spacing": {
              "padding": {
                "top": "0",
                "right": "0",
                "bottom": "0",
                "left": "0"
              }
            }
          }
        }
      },
      "core/pullquote": {
        "typography": {
          "fontSize": "var:preset|font-size|huge",
          "fontWeight": "400",
          "lineHeight": "1.2"
        },
        "elements": {
          "cite": {
            "typography": {
              "fontSize": "var:preset|font-size|small",
              "fontStyle": "normal"
            }
          }
        },
        "spacing": {
          "padding": {
            "bottom": "var:preset|spacing|30",
            "top": "var:preset|spacing|30"
          }
        },
        "css": "& p:last-of-type {margin-bottom: var(--wp--preset--spacing--30);}"
      },
      "core/query-pagination": {
        "typography": {
          "fontSize": "var:preset|font-size|regular",
          "fontWeight": "500"
        }
      },
      "core/search": {
        "css": "& .wp-block-search__input{border-radius:3.125rem;padding-left:1.5625rem;padding-right:1.5625rem;border-color:var(--wp--preset--color--rule);}",
        "typography": {
          "fontSize": "var:preset|font-size|regular",
          "lineHeight": "1.6"
        },
        "elements": {
          "button": {
            "border": {
              "radius": "3.125rem"
            },
            "spacing": {
              "margin": {
                "left": "1.125rem"
              }
            },
            ":hover": {
              "border": {
                "color": "transparent"
              }
            }
          }
        }
      },
      "core/separator": {
        "border": {
          "color": "currentColor",
          "style": "solid",
          "width": "0 0 1px 0"
        },
        "color": {
          "text": "var:preset|color|rule"
        },
        "spacing": {
          "margin": {
            "top": "var:preset|spacing|50",
            "bottom": "var:preset|spacing|50"
          }
        },
        "variations": {
          "wide": {
            "css": " &:not(.alignfull){max-width: var(--wp--style--global--wide-size) !important;}"
          }
        }
      },
      "core/site-tagline": {
        "typography": {
          "fontSize": "var:preset|font-size|regular"
        }
      },
      "core/site-title": {
        "typography": {
          "fontWeight": "500",
          "letterSpacing": "-.5px"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "typography": {
                "textDecoration": "underline"
              }
            }
          }
        }
      },
      "core/term-description": {
        "color": {
          "text": "var:preset|color|base"
        },
        "typography": {
          "fontSize": "var:preset|font-size|regular",
          "lineHeight": "var:custom|typography|line-height|base"
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "var:preset|font-size|regular"
        },
        "elements": {
          "link": {
            ":hover": {
              "typography": {
                "textDecoration": "underline"
              }
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/list": {
        "css": "& li{margin-top: 0.5rem;}",
        "spacing": {
          "margin": {
            "top": "0",
            "bottom": "var:preset|spacing|40"
          },
          "padding": {
            "left": "var:preset|spacing|40"
          }
        }
      },
      "core/image": {
        "spacing": {
          "margin": {
            "top": "0",
            "bottom": "var:preset|spacing|50"
          }
        }
      },
      "core/paragraph": {
        "color": {
          "text": "var:preset|color|muted"
        },
        "typography": {
          "fontSize": "var:preset|font-size|regular",
          "lineHeight": "var:custom|typography|line-height|base",
          "fontWeight": "400",
          "fontFamily": "var:preset|font-family|inter"
        },
        "spacing": {
          "margin": {
            "top": "0",
            "bottom": "var:preset|spacing|40"
          }
        },
        "css": "text-wrap: pretty;"
      },
      "core/group": {
        "spacing": {
          "blockGap": "0"
        }
      },
      "core/post-content": {
        "spacing": {
          "blockGap": "0"
        }
      },
      "core/cover": {
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|base"
            }
          }
        }
      },
      "core/accordion": {
        "spacing": {
          "blockGap": "20px"
        }
      },
      "core/accordion-item": {
        "color": {
          "background": "var:preset|color|surface"
        },
        "typography": {
          "fontSize": "var:preset|font-size|extra-large"
        },
        "border": {
          "radius": "12px",
          "color": "var:preset|color|rule"
        },
        "spacing": {
          "padding": {
            "top": "0px",
            "right": "0px",
            "bottom": "0px",
            "left": "0px"
          }
        }
      },
      "core/accordion-heading": {
        "color": {
          "background": "var:preset|color|surface",
          "text": "var:preset|color|ink-2"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|inter",
          "fontSize": "var:preset|font-size|extra-large",
          "fontWeight": "500",
          "lineHeight": "1.6"
        },
        "spacing": {
          "padding": {
            "top": "24px",
            "right": "35px",
            "bottom": "24px",
            "left": "35px"
          }
        },
        "border": {
          "radius": {
            "topLeft": "12px",
            "topRight": "12px",
            "bottomLeft": "0px",
            "bottomRight": "0px"
          }
        }
      },
      "core/accordion-panel": {
        "color": {
          "background": "var:preset|color|surface",
          "text": "var:preset|color|muted"
        },
        "typography": {
          "fontSize": "var:preset|font-size|regular",
          "lineHeight": "var:custom|typography|line-height|base"
        },
        "spacing": {
          "padding": {
            "top": "24px",
            "right": "35px",
            "bottom": "24px",
            "left": "35px"
          },
          "margin": {
            "top": "0px",
            "right": "0px",
            "bottom": "0px",
            "left": "0px"
          }
        },
        "border": {
          "radius": {
            "topLeft": "0px",
            "topRight": "0px",
            "bottomLeft": "12px",
            "bottomRight": "12px"
          }
        }
      }
    },
    "elements": {
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--white)"
        },
        "border": {
          "radius": "50px"
        },
        "typography": {
          "fontWeight": "500",
          "fontSize": "15px"
        },
        "spacing": {
          "padding": {
            "top": "14px",
            "bottom": "14px",
            "left": "32px",
            "right": "32px"
          }
        }
      },
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--fraunces)",
          "fontWeight": "400",
          "lineHeight": "1.1"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--fraunces)",
          "fontWeight": "400"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--fraunces)",
          "fontWeight": "400"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--fraunces)",
          "fontWeight": "400"
        }
